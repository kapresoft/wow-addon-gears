<Ui xmlns="http://www.blizzard.com/wow/ui/">

    <Script file="EquipmentSlotFlyoutMixin.lua"/>

    <Button name="GearsEquipmentSlotActionButton" inherits="UIButtonTemplate"
            virtual="true">
        <Size x="38" y="38"/>
        <Anchors>
            <Anchor point="CENTER" x=".5" y=".5"/>
        </Anchors>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>
                print("xx Slot excluded")
                self:GetParent():Hide()
            </OnClick>
        </Scripts>
        <NormalTexture file="Interface\AddOns\Gears\Assets\ui-button-empty"/>
        <PushedTexture file="Interface\AddOns\Gears\Assets\ui-button-empty" alpha="0.9" alphaMode="ADD"/>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alpha="0.6" alphaMode="ADD"/>
    </Button>

    <!-- Flyout Arrow Button -->
    <Button name="GearsEquipmentSlotFlyoutTemplate" mixin="Gears_EquipmentSlotFlyoutMixin"
            frameStrata="HIGH" frameLevel="1000" virtual="true">
        <Size x="52" y="16"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Arrow">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnClick method="OnClick"/>
        </Scripts>

        <Frames>
            <Frame parentKey="Flyout" hidden="false" inherits="BackdropTemplate">
                <KeyValues>
                    <KeyValue key="backdropInfo" value="GEARS_BACKDROP_TOAST_12_12" type="global"/>
                </KeyValues>
                <Size x="48" y="48"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" x="-23" y="0"/>
                </Anchors>

                <!--<Frames>
                    <Button parentKey="ExcludeButton" name="$parentExcludeButton" inherits="GearsEquipmentSlotActionButton">
                        <Scripts>
                            <OnLoad>
                                self.Icon:SetTexture([[Interface\Buttons\UI-GroupLoot-Pass-Up]])
                            </OnLoad>
                        </Scripts>
                    </Button>
                    <Button parentKey="IncludeButton" name="$parentIncludeButton" inherits="GearsEquipmentSlotActionButton">
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parentExcludeButton" relativePoint="RIGHT" x="0" y="0"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.Icon:SetTexture([[Interface\Icons\INV_Misc_Bag_08]])
                            </OnLoad>
                        </Scripts>
                    </Button>
                </Frames>-->
            </Frame>
        </Frames>
    </Button>

    <Button name="TestFlyoutButton" parent="UIParent" inherits="GearsEquipmentSlotFlyoutTemplate"
            hidden="true">
        <Anchors>
            <Anchor point="LEFT" relativeTo="CharacterShoulderSlot"
                    relativePoint="RIGHT" x="0"/>
        </Anchors>
    </Button>

</Ui>
