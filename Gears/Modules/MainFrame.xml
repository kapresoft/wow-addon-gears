<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Script file="MainFrame.lua"/>

    <Font name="Gears_LabelFont" inherits="GameFontWhiteTiny"
          justifyH="LEFT" virtual="true">
        <Color color="WHITE_FONT_COLOR"/>
    </Font>

    <Frame name="Gears_EquipmentSetTemplate" inherits="BackdropTemplate"
           enableMouse="true" virtual="true">
        <Size y="48"/>
        <KeyValues>
            <KeyValue key="backdropInfo" value="BACKDROP_TOAST_12_12" type="global"/>
        </KeyValues>

        <Scripts>
            <OnEnter>
                self:SetBackdropColor(0, 0, 0, 0.6)
                self:SetBackdropBorderColor(1, 1, 1, 0.8)
            </OnEnter>
            <OnLeave>
                self:SetBackdropColor(0, 0, 0, 0)
                self:SetBackdropBorderColor(0, 0, 0, 0)
            </OnLeave>
        </Scripts>

        <Anchors>
            <Anchor point="TOPLEFT" x="5" />
            <Anchor point="TOPRIGHT" x="-26" />
        </Anchors>

        <Frames>
            <Button parentKey="IconButton"
                    inherits="IconButtonTemplate">
                <Size x="36" y="36"/>
                <Anchors>
                    <Anchor point="LEFT" x="8" y="0"/>
                </Anchors>
                <NormalTexture file="Interface\Icons\INV_Misc_QuestionMark"/>
            </Button>
        </Frames>

        <Layers>
            <Layer level="ARTWORK">
                <!-- Text aligned to the right of the icon -->
                <FontString name="$parentLabel"
                            parentKey="Label"
                            text="DPS"
                            inherits="Gears_LabelFont"
                            justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT"
                                relativeKey="$parent.IconButton"
                                relativePoint="RIGHT"
                                x="10" y="0"/>
                        <Anchor point="RIGHT" x="-10" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <!--<Layer level="HIGHLIGHT">
                <Texture parentKey="Highlight"
                         file="Interface\\QuestFrame\\UI-QuestTitleHighlight"
                         blendMode="ADD"
                         alpha="0.35">
                    <Scripts>
                        <OnEnter>self:Show(); print('xx Show()')</OnEnter>
                        <OnLeave>self:Hide()</OnLeave>
                    </Scripts>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>-->
        </Layers>
    </Frame>

    <Frame name="Gears_MainFrameTemplate" virtual="true"
           mixin="Gears_MainFrameMixin"
           hidden="true" movable="true" enableMouse="true"
           frameStrata="DIALOG" clampedToScreen="true">

        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>

        <Size x="200" y="427"/>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentTitleFrameHeader" parentKey="TitleFrameHeader"
                         file="Interface\DialogFrame\UI-DialogBox-Header">
                    <Size x="256" y="64"/>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOP" x="0" y="12"/>
                    </Anchors>
                    <Scripts>
                        <OnMouseDown>
                            if button == "LeftButton" then
                            self:GetParent():StartMoving()
                            end
                        </OnMouseDown>

                        <OnMouseUp>
                            self:GetParent():StopMovingOrSizing()
                        </OnMouseUp>
                    </Scripts>
                </Texture>
                <FontString name="$parentDialogTitle" parentKey="HeaderTitle"
                            inherits="GameFontNormal">
                    <Size>
                        <AbsDimension x="185" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOP" x="0" y="-2" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <!-- Scroll area for icons -->
        <Frames>
            <Frame parentKey="ButtonsContainerFrame">
                <Size x="180" y="22"/>
                <Anchors>
                    <Anchor point="TOP" relativePoint="TOP" x="0" y="-26"/>
                </Anchors>
                <Frames>
                    <Button parentKey="EquipButton"
                            inherits="UIPanelButtonTemplate"
                            text="Equip">
                        <Size x="90" y="22"/>
                        <Anchors>
                            <Anchor point="LEFT"/>
                        </Anchors>
                    </Button>

                    <Button parentKey="SaveButton"
                            inherits="UIPanelButtonTemplate"
                            text="Save">
                        <Size x="90" y="22"/>
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.EquipButton"
                                    relativePoint="RIGHT"
                                    x="0" y="0"/>
                        </Anchors>
                    </Button>
                </Frames>
            </Frame>
            <ScrollFrame parentKey="ScrollFrame"
                         inherits="UIPanelScrollFrameTemplate,BackdropTemplate">
                <Size x="190" y="330"/>
                <!--<KeyValues>
                    <KeyValue key="backdropInfo" value="BACKDROP_TOAST_12_12" type="global"/>
                </KeyValues>-->
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.ButtonsContainerFrame"
                            relativePoint="BOTTOM" y="-5" />
                    <Anchor point="LEFT" x="5"/>
                    <Anchor point="RIGHT" x="-34"/>
                    <Anchor point="BOTTOM" y="5"/>
                </Anchors>

                <Frames>
                    <!-- THIS is what scrolls -->
                    <Frame parentKey="ScrollChild" >
                        <Size x="190" y="330"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"/>
                            <Anchor point="TOPRIGHT"/>
                        </Anchors>
                        <Frames>
                        </Frames>
                    </Frame>
                </Frames>
            </ScrollFrame>
        </Frames>
    </Frame>

    <Frame name="Gears_EquipmentSetFrame" hidden="true" movable="true" enableMouse="true"
           inherits="BackdropTemplate, Gears_MainFrameTemplate">
    </Frame>
</Ui>
